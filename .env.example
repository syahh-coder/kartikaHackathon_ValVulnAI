# Preferred live provider: Groq (.env.groq.example); OpenRouter/Azure remain explicit alternatives.
# This fresh-install MOCK example keeps the legacy OpenRouter selector; no API calls at startup.
# See docs/provider-setup.md; Azure template is .env.azure.example.
VALVULN_TRIAGE_PROVIDER=openrouter
# Lab planner remains mock; text inference has an independent mode.
VALVULN_EXECUTION_MODE=mock
VALVULN_TRIAGE_MODE=mock
VALVULN_PUBLIC_ORIGIN=http://127.0.0.1:8000
VALVULN_ALLOW_HTTP_LOOPBACK=true
VALVULN_COOKIE_SECURE=false
# Local Python only: Docker sets its own persistent path.
VALVULN_DATA_DIR=.local-data
VALVULN_BUDGET_IDR=50000

# App and optional evaluator profile only. Worker/lab never receive these keys.
# Configure privately after checking actual model/access/prices.
# Never put real values in this tracked example. See docs/r1-verification.md.
# VALVULN_OPENROUTER_API_KEY=
# VALVULN_TRIAGE_MODEL=
# VALVULN_TRIAGE_PROVIDER_SLUG=
# VALVULN_TRIAGE_PROVIDER_NAME=
# VALVULN_TRIAGE_ACCESS_TIER=PAID
# VALVULN_TRIAGE_ACCESS_VERIFIED=false
# VALVULN_TRIAGE_TOKEN_BOUND_VERIFIED=false
# VALVULN_TRIAGE_PRICE_SNAPSHOT=
# VALVULN_TRIAGE_PROMPT_USD_PER_MILLION=
# VALVULN_TRIAGE_COMPLETION_USD_PER_MILLION=
# VALVULN_TRIAGE_USD_TO_IDR=
# VALVULN_TRIAGE_RESERVATION_IDR=
# VALVULN_TRIAGE_TIMEOUT_SECONDS=30
# VALVULN_TRIAGE_RETRY_ENABLED=false
