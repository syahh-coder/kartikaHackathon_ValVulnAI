# PRIVATE COPY: .env.groq. Never commit an actual key.
# Keep the existing Compose project, app_data volume and shared ledger.
VALVULN_TRIAGE_MODE=live
VALVULN_TRIAGE_PROVIDER=groq
VALVULN_GROQ_API_KEY=
VALVULN_TRIAGE_MODEL=openai/gpt-oss-120b
VALVULN_TRIAGE_PROVIDER_SLUG=groq
VALVULN_TRIAGE_PROVIDER_NAME=Groq
VALVULN_TRIAGE_ACCESS_TIER=FREE_TIER
# Set true only after verifying Free Plan and model access in your console.
VALVULN_TRIAGE_ACCESS_VERIFIED=false
# Operator verifies the tokenizer bound before enabling live requests.
VALVULN_TRIAGE_TOKEN_BOUND_VERIFIED=false
VALVULN_TRIAGE_PRICE_SNAPSHOT=Groq Free Plan documentation checked 2026-11-14; account eligibility pending
VALVULN_TRIAGE_PROMPT_USD_PER_MILLION=0
VALVULN_TRIAGE_COMPLETION_USD_PER_MILLION=0
VALVULN_TRIAGE_USD_TO_IDR=16000
# Conservative reservation, not an actual charge. Unknown cost remains reserved.
VALVULN_TRIAGE_RESERVATION_IDR=100
VALVULN_TRIAGE_TIMEOUT_SECONDS=60
VALVULN_TRIAGE_RETRY_ENABLED=false
VALVULN_BUDGET_IDR=50000
