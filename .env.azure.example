# PRIVATE COPY: .env.azure. This public template contains no usable credentials.
# No cloud calls at startup. Check first: python -m scripts.check_azure_config
VALVULN_TRIAGE_MODE=live
VALVULN_TRIAGE_PROVIDER=azure
VALVULN_AZURE_API_KEY=
# Resource origin or /openai/v1/. NOT /api/projects/... or a chat-completions URL.
VALVULN_AZURE_ENDPOINT=
# Exact deployment name from Foundry. Example only: valvuln-chat
VALVULN_TRIAGE_MODEL=
# Exact returned model identity, including version where applicable.
VALVULN_AZURE_EXPECTED_MODEL=
VALVULN_TRIAGE_PROVIDER_SLUG=azure
VALVULN_TRIAGE_PROVIDER_NAME=Azure
VALVULN_TRIAGE_ACCESS_TIER=PROMO_CREDIT
# Change to true ONLY after checking your Students subscription, credit and quota.
VALVULN_TRIAGE_ACCESS_VERIFIED=false
# Verify byte-BPE tokenizer and non-reasoning chat deployment supports temperature=0,
# max_completion_tokens and strict json_schema on OpenAI v1 before enabling.
VALVULN_TRIAGE_TOKEN_BOUND_VERIFIED=false
VALVULN_AZURE_API_CAPABILITIES_VERIFIED=false
# Fill a dated tariff/region/deployment/version/credit note (no secrets).
VALVULN_TRIAGE_PRICE_SNAPSHOT=
# Uncomment and fill current USD per million tokens and conservative USD/IDR.
# Cached-input discounts are ignored; use full input/output tariffs, never credit=0.
# VALVULN_TRIAGE_PROMPT_USD_PER_MILLION=
# VALVULN_TRIAGE_COMPLETION_USD_PER_MILLION=
# VALVULN_TRIAGE_USD_TO_IDR=
# Checker prints minimum reservation after tariffs are filled; set >= that amount.
VALVULN_TRIAGE_RESERVATION_IDR=0
VALVULN_TRIAGE_TIMEOUT_SECONDS=30
VALVULN_TRIAGE_RETRY_ENABLED=false
VALVULN_BUDGET_IDR=50000
